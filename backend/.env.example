# Server Configuration
NODE_ENV=development
PORT=3001

# Cookie di sessione legacy leghe.fantacalcio.it (FCLeague2026)
# Necessario per l'endpoint classificagiornate (scade ogni ~8 giorni)
# Come ottenerlo:
#   1. Apri leghe.fantacalcio.it nel browser e fai il login
#   2. DevTools → Application → Cookies → .fantacalcio.it → FCLeague2026
#   3. Copia il Value (inizia con "0=Tx2v...")
#   4. Incollalo qui OPPURE aggiornalo in-memory via: POST /api/scrape/cookie {"cookie":"..."}
FC_LEGACY_COOKIE=

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tutti-vs-tutti?retryWrites=true&w=majority
# Locale:
# MONGODB_URI=mongodb://localhost:27017/tuttivstut

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
# Produzione:
# CORS_ORIGIN=https://tutti-vs-tutti.vercel.app

# Fantacalcio Credentials (leghe.fantacalcio.it)
FC_USERNAME=tuo_username_fantacalcio
FC_PASSWORD=tua_password_fantacalcio
FC_LEGA_SLUG=lega-liz-zar
FC_SEASON=2025-26

# Admin Protection
ADMIN_SECRET=cambia_questo_segreto_admin

# JWT Configuration
JWT_SECRET=cambia_questo_segreto_jwt
JWT_EXPIRES_IN=7d
